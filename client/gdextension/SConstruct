
#!/usr/bin/env python

import os
import sys

# Set default godot-cpp configuration options.
ARGUMENTS.setdefault("api_version", "4.7")
ARGUMENTS.setdefault("compiledb", "yes")
ARGUMENTS.setdefault("use_llvm", "yes")
ARGUMENTS.setdefault("precision", "single")

# Enable ThinLTO through the native godot-cpp option.
ARGUMENTS.setdefault("lto", "thin")

# Configure godot-cpp.
env = SConscript("godot-cpp/SConstruct")

# Use LLD as the linker on Linux when LLVM is enabled.
if env.get("use_llvm", False) and env.get("platform") == "linux":
    env.Append(
        LINKFLAGS=["-fuse-ld=lld"],
        SHLINKFLAGS=["-fuse-ld=lld"],
    )

# Configure header search paths.
env.Append(CPPPATH=["src/", "/usr/local/include"])

# Collect GDExtension source files.
sources = Glob("src/*.cpp")

lib_name = "world_generator"
project_dir = "demo"

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "{}/bin/lib{}.{}.{}.framework/lib{}.{}.{}".format(
            project_dir,
            lib_name,
            env["platform"],
            env["target"],
            lib_name,
            env["platform"],
            env["target"],
        ),
        source=sources,
    )

elif env["platform"] == "ios":
    if env["ios_simulator"]:
        library = env.StaticLibrary(
            "{}/bin/lib{}.{}.{}.simulator.a".format(
                project_dir,
                lib_name,
                env["platform"],
                env["target"],
            ),
            source=sources,
        )
    else:
        library = env.StaticLibrary(
            "{}/bin/lib{}.{}.{}.a".format(
                project_dir,
                lib_name,
                env["platform"],
                env["target"],
            ),
            source=sources,
        )

else:
    library = env.SharedLibrary(
        "{}/bin/lib{}{}{}".format(
            project_dir,
            lib_name,
            env["suffix"],
            env["SHLIBSUFFIX"],
        ),
        source=sources,
    )

# Set the default build target.
Default(library)
