[configuration]

entry_symbol = "world_generator_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "res://bin/libworld_generator.macos.template_debug.framework"
macos.release = "res://bin/libworld_generator.macos.template_release.framework"

windows.debug.x86_32 = "res://bin/world_generator.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/world_generator.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/world_generator.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/world_generator.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libworld_generator.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libworld_generator.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libworld_generator.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libworld_generator.linux.template_release.arm64.so"
linux.debug.rv64 = "res://bin/libworld_generator.linux.template_debug.rv64.so"
linux.release.rv64 = "res://bin/libworld_generator.linux.template_release.rv64.so"