{
  "name": "Chimera Wayland (Nouveau)",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../compose/linux-podman.yml",
    "../compose/nouveau.yml"
  ],
  "service": "godot",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/GodotNakama.code-workspace",
  "features": {
    "../features/common-vscode": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/go:1.4.0": {
      "version": "1.27.1"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {}
  },
  "mounts": [
    {
      "source": "/run/user/1000/podman/podman.sock",
      "target": "/var/run/docker-host.sock",
      "type": "bind"
    }
  ],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "remoteUser": "root",
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
    "TESTCONTAINERS_RYUK_DISABLED": "true",
    "DISPLAY": ":0",
    "WAYLAND_DISPLAY": "wayland-1",
    "XDG_RUNTIME_DIR": "/tmp/runtime-dir",
    "PULSE_SERVER": "unix:/tmp/runtime-dir/pulse/native",
    "VSCODE_DOTNET_RUNTIME_DISABLE_MUTEX": "true"
  },
  "containerEnv": {
    "COMPOSE_ARGS": "--env-file versions.env -f .devcontainer/docker-compose.yml -f .devcontainer/compose/linux-podman.yml -f .devcontainer/compose/nouveau.yml"
  },
  "forwardPorts": [
    6007,
    6008
  ],
  "portsAttributes": {
    "6007": {
      "label": "Godot Remote Debugger",
      "onAutoForward": "notify"
    },
    "6008": {
      "label": "GDScript Language Server",
      "onAutoForward": "notify"
    }
  },
  "shutdownAction": "stopCompose"
}