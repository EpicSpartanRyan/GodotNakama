{
  "name": "Godot Nakama Environment Linux",
  "dockerComposeFile": "docker-compose.yml",
  "service": "godot",
  "workspaceFolder": "/home/ubuntu/${localWorkspaceFolderBasename}/GodotNakama.code-workspace",
  "initializeCommand": "xhost +local:",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/starship:1.0.10": {},
    "ghcr.io/devcontainers/features/go:1.4.0": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd", // C++ / Clangd Support
        "vadimcn.vscode-lldb",
        "ms-vscode.cmake-tools",

        "ms-dotnettools.csdevkit", // C# Language
        "EditorConfig.EditorConfig",
        "csharpier.csharpier-vscode",
        "drain99.perfetto-trace", // Profiling visualization

        "golang.go", // Go Language

        "geequlim.godot-tools", // Godot Support
        "neikeq.godot-csharp-vscode",
        "alfish.godot-files",

        "GitHub.vscode-pull-request-github", // GitHub PR's/Actions, Tasks
        "github.vscode-github-actions",
        "isopodlabs.taskviewer",

        "ms-ossdata.vscode-pgsql", // PostgreSQL Management

        "qwtel.sqlite-viewer", // SQLite Support

        "ms-azuretools.vscode-containers", // Docker and Kubernetes
        "ms-azuretools.vscode-docker",
        "docker.docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        
        "redhat.vscode-yaml", // Files
        "redhat.vscode-xml",
        "AykutSarac.jsoncrack-vscode",
        "tamasfe.even-better-toml",
        "grimaldi-tech.aseprite-preview",
        "three-flatland.fl-tools",
        "ms-vscode.hexeditor",
        "YuTengjing.open-in-external-app"
      ],
      "settings": {
        "workbench.editorAssociations": {
          "*.chromium.json": "perfetto-trace.perfetto-native-editor"
        },
        "files.associations": {
          "*.cs.template": "csharp"
        },
        "csharp.experimental.debug.hotReload": true,
        "csharp.debug.hotReloadOnSave": true,
        "openInExternalApp.openMapper": [
          {
            "extensionName": "aseprite",
            "apps": [
              {
                "title": "Aseprite",
                "shellCommand": "aseprite ${file}",
                "wslConvertWindowsPath": false
              }
            ]
          },
          {
            "extensionName": "inp",
            "apps": [
              {
                "title": "Inochi Creator",
                "shellCommand": "export SDL_VIDEODRIVER=x11; export XDG_STATE_HOME=\"${HOME}/.local/state\"; mkdir -p \"$XDG_STATE_HOME\"; dbus-launch /opt/inochi-creator/inochi-creator \"${file}\"",
                "wslConvertWindowsPath": false
              }
            ]
          },
          {
            "extensionName": "godot",
            "apps": [
              {
                "title": "Godot Editor",
                "shellCommand": "godot -e --path \"${fileDirname}\"",
                "wslConvertWindowsPath": false
              }
            ]
          },
          {
            "extensionName": "psd",
            "apps": [
              {
                "title": "GIMP",
                "shellCommand": "gimp \"${file}\"",
                "wslConvertWindowsPath": false
              }
            ]
          }
        ]
      }
    }
  },
  "remoteUser": "ubuntu",
  "remoteEnv": {
    "NVIDIA_DRIVER_CAPABILITIES": "all",
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
    "DISPLAY": ":1",
    "WAYLAND_DISPLAY": "",
    "XDG_RUNTIME_DIR": "/tmp/runtime-dir",
    "PULSE_SERVER": "unix:/tmp/runtime-dir/pulse/native",
    "VSCODE_DOTNET_RUNTIME_DISABLE_MUTEX": "true"
  },
  "containerEnv": {
    "COMPOSE_YML_PATH": "/home/ubuntu/${localWorkspaceFolderBasename}/.devcontainer/linux-nvidia/docker-compose.yml"
  },
  "forwardPorts": [
    6007,
    6008
  ],
  "portsAttributes": {
    "6007": {
      "label": "Godot Remote Debugger",
      "onAutoForward": "notify"
    },
    "6008": {
      "label": "GDScript Language Server",
      "onAutoForward": "notify"
    }
  },
  "shutdownAction": "stopCompose"
}