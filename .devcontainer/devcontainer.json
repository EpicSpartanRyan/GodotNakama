{
  "name": "Godot Nakama Environment",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "godot",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/starship:1": {},
    "ghcr.io/devcontainers/features/go:1": {},
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit", // C# Language

        "golang.go", // Go Language

        "geequlim.godot-tools", // Godot Support
        "neikeq.godot-csharp-vscode",

        "ms-azuretools.vscode-containers", // Docker and Kubernetes
        "ms-azuretools.vscode-docker",
        "docker.docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-vscode-remote.remote-containers",

        "ms-vscode-remote.remote-ssh", // Remote development
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode.remote-explorer",

        "redhat.vscode-yaml"
      ]
    }
  },
  "remoteUser": "root",
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
    "DISPLAY": ":0",
    "WAYLAND_DISPLAY": "wayland-0",
    "XDG_RUNTIME_DIR": "/tmp/runtime-dir"
  },
  "forwardPorts": [7351],
  "portsAttributes": {
    "7351": {
      "label": "Nakama Panel",
      "onAutoForward": "notify"
    }
  },
  "shutdownAction": "stopCompose"
}
