{
  "name": "Godot Nakama Environment",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "godot",
  "workspaceFolder": "/home/ubuntu/${localWorkspaceFolderBasename}/GodotNakama.code-workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/${localWorkspaceFolderBasename},type=bind",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/starship:1": {},
    "ghcr.io/devcontainers/features/go:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit", // C# Language
        "EditorConfig.EditorConfig",

        "golang.go", // Go Language

        "geequlim.godot-tools", // Godot Support
        "neikeq.godot-csharp-vscode",

        "GitHub.vscode-pull-request-github", // GitHub PR's/Actions, Tasks
        "github.vscode-github-actions",
        "spmeesseman.vscode-taskexplorer",

        "ms-ossdata.vscode-pgsql", // PostgreSQL Management

        "ms-azuretools.vscode-containers", // Docker and Kubernetes
        "ms-azuretools.vscode-docker",
        "docker.docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        
        "redhat.vscode-yaml"
      ]
    }
  },
  "remoteUser": "ubuntu",
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
    "DISPLAY": ":0",
    "WAYLAND_DISPLAY": "wayland-0",
    "XDG_RUNTIME_DIR": "/tmp/runtime-dir",
    "PULSE_SERVER": "unix:/tmp/runtime-dir/pulse/native"
  },
  "forwardPorts": [6007, 6008, 7349, 7350, 7351, 5432],
  "portsAttributes": {
    "6007": {
      "label": "Godot Remote Debugger",
      "onAutoForward": "notify"
    },
    "6008": {
      "label": "GSCript Language Server",
      "onAutoForward": "notify"
    },
    "7349": {
      "label": "Nakama gRPC API",
      "onAutoForward": "notify"
    },
    "7350": {
      "label": "Nakama Client API",
      "onAutoForward": "notify"
    },
    "7351": {
      "label": "Nakama Panel",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "Nakama Database",
      "onAutoForward": "notify"
    }
  },
  "shutdownAction": "stopCompose"
}