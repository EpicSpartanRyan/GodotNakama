{
  "name": "Godot Nakama Environment",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "godot",
  "workspaceFolder": "/home/ubuntu/${localWorkspaceFolderBasename}/GodotNakama.code-workspace",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/starship:1.0.10": {},
    "ghcr.io/devcontainers/features/go:1.3.4": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd", // C++ / Clangd Support
        "vadimcn.vscode-lldb",

        "ms-dotnettools.csdevkit", // C# Language
        "EditorConfig.EditorConfig",

        "golang.go", // Go Language

        "geequlim.godot-tools", // Godot Support
        "neikeq.godot-csharp-vscode",
        "alfish.godot-files",

        "GitHub.vscode-pull-request-github", // GitHub PR's/Actions, Tasks
        "github.vscode-github-actions",
        "spmeesseman.vscode-taskexplorer",

        "ms-ossdata.vscode-pgsql", // PostgreSQL Management

        "ms-azuretools.vscode-containers", // Docker and Kubernetes
        "ms-azuretools.vscode-docker",
        "docker.docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        
        "redhat.vscode-yaml", // Files
        "AykutSarac.jsoncrack-vscode",
        "grimaldi-tech.aseprite-preview",
        "qwtel.sqlite-viewer",
        "ms-vscode.hexeditor",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "remoteUser": "ubuntu",
  "remoteEnv": {
    "NVIDIA_DRIVER_CAPABILITIES": "all",
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
    "DISPLAY": ":0",
    "WAYLAND_DISPLAY": "wayland-0",
    "XDG_RUNTIME_DIR": "/tmp/runtime-dir",
    "PULSE_SERVER": "unix:/tmp/runtime-dir/pulse/native"
  },
  "forwardPorts": [6007, 6008],
  "portsAttributes": {
    "6007": {
      "label": "Godot Remote Debugger",
      "onAutoForward": "notify"
    },
    "6008": {
      "label": "GSCript Language Server",
      "onAutoForward": "notify"
    }
  },
  "shutdownAction": "stopCompose"
}