{
  "name": "Linux (CPU)",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../compose/linux.yml",
    "../compose/cpu.yml"
  ],
  "service": "godot",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/GodotNakama.code-workspace",
  "initializeCommand": "xhost +local:",
  "features": {
    "../features/common-vscode": {},
    "ghcr.io/devcontainers/features/node:2.1.2": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.3": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/go:1.4.1": {
      "version": "1.27.3"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {}
  },
  "mounts": [
    {
      "source": "godotnakama-cline-data",
      "target": "/home/ubuntu/.cline",
      "type": "volume"
    },
    {
      "source": "godotnakama-vscode-globalstorage",
      "target": "/home/ubuntu/.vscode-server/data/User/globalStorage",
      "type": "volume"
    }
  ],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "remoteUser": "ubuntu",
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
    "DISPLAY": ":1",
    "WAYLAND_DISPLAY": "",
    "XDG_RUNTIME_DIR": "/tmp/runtime-dir",
    "PULSE_SERVER": "unix:/tmp/runtime-dir/pulse/native",
    "VSCODE_DOTNET_RUNTIME_DISABLE_MUTEX": "true"
  },
  "containerEnv": {
    "COMPOSE_ARGS": "--env-file versions.env -f .devcontainer/docker-compose.yml -f .devcontainer/compose/linux.yml -f .devcontainer/compose/cpu.yml"
  },
  "forwardPorts": [
    6007,
    6008
  ],
  "portsAttributes": {
    "6007": {
      "label": "Godot Remote Debugger",
      "onAutoForward": "notify"
    },
    "6008": {
      "label": "GDScript Language Server",
      "onAutoForward": "notify"
    }
  },
  "shutdownAction": "stopCompose",
  "postCreateCommand": "sudo chown -R ubuntu:ubuntu /home/ubuntu/.cline /home/ubuntu/.vscode-server/data/User/globalStorage"
}