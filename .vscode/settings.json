{
  "editor.formatOnSave": true,
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode"
  },
  "[gdscript]": {
    "editor.defaultFormatter": "geequlim.godot-tools"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "files.exclude": {
    "**/*.uid": true,
    "backend/vendor/": true,
    "backend/.vscode/": true,
    "client/sample-game/.godot/": true,
    "client/sample-game/.vscode/": true
  },
  "search.exclude": {
    "**/*.uid": true,
    "backend/vendor/": true,
    "backend/.vscode/": true,
    "client/sample-game/.godot/": true,
    "client/sample-game/.vscode/": true
  },
  "files.watcherExclude": {
    "**/*.uid": true,
    "backend/vendor/": true,
    "backend/.vscode/": true,
    "client/sample-game/.godot/": true,
    "client/sample-game/.vscode/": true
  },
  "files.readonlyInclude": {
    "**/*.sum": true,
    "**/*.uid": true,
    "**/*.template": true,
    "LICENSE": true
  },
  "cmake.sourceDirectory": "/workspaces/GodotNakama/client/gdextension/godot-cpp"
