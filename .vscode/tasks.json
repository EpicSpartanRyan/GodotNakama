{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Starship in Bashrc",
      "type": "shell",
      "command": "grep -qxF 'eval \"$(starship init bash)\"' ~/.bashrc || echo 'eval \"$(starship init bash)\"' >> ~/.bashrc && echo 'Listo'",
      "problemMatcher": []
    },
    {
      "label": "Start Godot",
      "type": "shell",
      "command": "godot -e",
      "problemMatcher": []
    },
    {
      "label": "Start Aseprite",
      "type": "shell",
      "command": "aseprite",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Stop all Godot processes",
      "type": "shell",
      "command": "ps -eo pid=,comm= | awk 'tolower($2) ~ /^godot/ {print $1}' | xargs -r kill -TERM",
      "problemMatcher": []
    },
    {
      "label": "Fix Godot game input",
      "type": "shell",
      "command": "sed -i 's|^run/window_placement/game_embed_mode = .*|run/window_placement/game_embed_mode = -1|' ~/.config/godot/editor_settings-4.7.tres && echo 'Godot game input fixed.'",
      "problemMatcher": []
    },
    {
      "label": "Install Godot Addons",
      "type": "shell",
      "command": "godot --headless -s plug.gd install; rm -rf .plugged",
      "options": {
        "cwd": "${workspaceFolder}/client/sample-game"
      },
      "problemMatcher": []
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/client/sample-game"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Environment Doctor",
      "type": "shell",
      "command": "./doctor.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}