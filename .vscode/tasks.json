{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Instalar Starship en Bashrc",
      "type": "shell",
      "command": "echo 'eval \"$(starship init bash)\"' >> ~/.bashrc && echo '¡Listo!'",
      "problemMatcher": []
    },
    {
      "label": "Iniciar Godot",
      "type": "shell",
      "command": "godot -e",
      "problemMatcher": []
    },
    {
      "label": "Detener todos los procesos de Godot",
      "type": "shell",
      "command": "ps -eo pid=,comm= | awk 'tolower($2) ~ /^godot/ {print $1}' | xargs -r kill -TERM",
      "problemMatcher": []
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/client/sample-game"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}