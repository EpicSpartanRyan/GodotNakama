{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Act: Build All",
      "group": "act",
      "type": "shell",
      "command": "echo '✅ All Github Local Actions finalized their execution successfully.'",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Act: Build Nakama Plugin",
        "Act: Build Godot Executables"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Act: Build Nakama Plugin",
      "group": "act",
      "type": "shell",
      "command": "act",
      "args": [
        "--workflows",
        ".github/workflows/nakama-build.yml",
        "--job",
        "build-plugin",
        "--secret-file",
        ".secrets",
        "--artifact-server-path",
        "${workspaceFolder}/.act-artifacts"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Act: Build Godot Executables",
      "group": "act",
      "type": "shell",
      "command": "act",
      "args": [
        "--workflows",
        ".github/workflows/godot-build.yml",
        "--job",
        "build-executables",
        "--secret-file",
        ".secrets",
        "--artifact-server-path",
        "${workspaceFolder}/.act-artifacts"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Act: Nakama Deploy",
      "group": "act",
      "type": "shell",
      "command": "act",
      "args": [
        "--workflows",
        ".github/workflows/deploy.yml",
        "--job",
        "build-and-deploy",
        "--secret-file",
        ".secrets",
        "--artifact-server-path",
        "${workspaceFolder}/.act-artifacts"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Environment: Run all first time recommended tasks",
      "group": "environment",
      "type": "shell",
      "command": "echo 'Environment setup completed successfully.'",
      "dependsOrder": "sequence",
      "dependsOn": [
        ".NET: Restore Tools",
        ".NET: Install Profiler",
        "Templates: Instantiate",
        "Starship: Install in all terminals",
        "Aseprite: Install Languages",
        "Aseprite: Install Tools",
        "Godot: Install Export Templates",
        "Godot: Install Addons",
        "Godot: Build",
        "Godot: Export Game",
        "Nakama: Build & Restart",
        "Nakama: Open Panel",
        "Environment: Run Doctor"
      ],
      "problemMatcher": []
    },
    {
      "label": "Environment: Run Doctor",
      "group": "environment",
      "type": "shell",
      "command": "set -o pipefail; mkdir -p logs; log_file=\"logs/doctor-$(date +%Y%m%d-%H%M%S).log\"; ./doctor.sh --verbose 2>&1 | tee \"$log_file\"; pipeline_status=(\"${PIPESTATUS[@]}\"); sed -i 's/\\x1B\\[[0-9;]*[mK]//g' \"$log_file\"; if (( pipeline_status[0] != 0 )); then exit \"${pipeline_status[0]}\"; elif (( pipeline_status[1] != 0 )); then echo 'ERROR: Failed to write the doctor log.' >&2; exit \"${pipeline_status[1]}\"; fi; printf 'Doctor output saved to %s\\n' \"$log_file\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": ".NET: Restore Tools",
      "group": ".net",
      "type": "shell",
      "command": "dotnet tool restore",
      "problemMatcher": []
    },
    {
      "label": ".NET: Install Profiler",
      "group": ".net",
      "type": "shell",
      "command": "set -o pipefail; if dotnet tool list --global | grep -Eq '^[[:space:]]*dotnet-trace[[:space:]]'; then echo 'dotnet-trace is already installed globally.'; else dotnet tool install --global dotnet-trace; fi",
      "problemMatcher": []
    },
    {
      "label": "Aseprite: Start",
      "group": "apps",
      "type": "shell",
      "command": "DIR=\"${workspaceFolder}/${input:asepriteProjectSelect}\"; mkdir -p ~/.config/aseprite && touch ~/.config/aseprite/aseprite.ini && if grep -q 'current_folder' ~/.config/aseprite/aseprite.ini; then sed -i \"s|^current_folder = .*|current_folder = $DIR|\" ~/.config/aseprite/aseprite.ini; else echo -e \"\\n[file_selector]\\ncurrent_folder = $DIR\" >> ~/.config/aseprite/aseprite.ini; fi; cd \"$DIR\" && aseprite",
      "problemMatcher": []
    },
    {
      "label": "Aseprite: Install Languages",
      "group": "aseprite",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/.vscode/scripts/install-aseprite-assets.sh\" languages \"${workspaceFolder}/aseprite-languages.txt\"",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Aseprite: Install Tools",
      "group": "aseprite",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/.vscode/scripts/install-aseprite-assets.sh\" tools \"${workspaceFolder}/aseprite-tools.txt\"",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Aseprite: Fix and Override PSD",
      "group": "aseprite",
      "type": "shell",
      "command": "gimp -i -b '(let* ((image (car (gimp-file-load RUN-NONINTERACTIVE \"${input:psdFilePath}\" \"${input:psdFilePath}\"))) (layers (gimp-image-get-layers image))) (if (> (car layers) 0) (gimp-file-save RUN-NONINTERACTIVE image (aref (cadr layers) 0) \"${input:psdFilePath}\" \"${input:psdFilePath}\")) (gimp-image-delete image))' -b '(gimp-quit 0)'",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}/client/sample-game"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Inochi: Start",
      "group": "apps",
      "type": "shell",
      "command": "export SDL_VIDEODRIVER=x11; export XDG_STATE_HOME=\"${HOME}/.local/state\"; mkdir -p \"$XDG_STATE_HOME\"; dbus-launch /opt/inochi-creator/inochi-creator",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: View Logs (Nakama / DB)",
      "group": "docker",
      "type": "shell",
      "command": "set -o pipefail; docker compose $COMPOSE_ARGS logs -f --tail 100 ${input:serviceLogSelect} | GREP_COLORS='mt=01;36' grep --color=always -E '${input:logHighlight}|$'",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Git: Simulate Clean",
      "group": "git",
      "type": "shell",
      "command": "git clean -ndx -e .secrets -e .vscode/vscode-kanban.json -e nakama/my-config.yml -e client/sample-game/src/config/Secrets.cs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Clean",
      "group": "git",
      "type": "shell",
      "command": "printf 'Continue cleanup? [\\033[32myes\\033[0m/\\033[31mno\\033[0m] (default: \\033[31mno\\033[0m): '; read -r answer; if [ \"$answer\" != \"yes\" ]; then printf '\\033[31mCleanup cancelled.\\033[0m\\n'; exit 0; fi; git clean -fdx -e .secrets -e .vscode/vscode-kanban.json -e nakama/my-config.yml -e client/sample-game/src/config/Secrets.cs",
      "dependsOrder": "sequence",
      "dependsOn": "Git: Simulate Clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Godot: Build",
      "group": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "Sample-Game.csproj"
      ],
      "options": {
        "cwd": "${workspaceFolder}/client/sample-game"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "GDExtension: Initialize Submodules",
      "group": "build",
      "type": "process",
      "command": "git",
      "args": [
        "submodule",
        "update",
        "--init",
        "--recursive"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GDExtension: Build with SCons",
      "group": "build",
      "type": "process",
      "command": "scons",
      "options": {
        "cwd": "${workspaceFolder}/client/gdextension"
      },
      "problemMatcher": []
    },
    {
      "label": ".NET: Test",
      "group": "testing",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/client/sample-game.Tests/Sample-Game.Tests.csproj"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Godot: Export Game",
      "group": "build",
      "type": "shell",
      "command": "set -Eeuo pipefail; target=\"${input:godotExportPlatform}\"; mkdir -p builds/windows builds/linux builds/macos; if [[ \"$target\" == \"All\" ]]; then for platform in \"Windows Desktop\" Linux macOS; do godot --headless --export-release \"$platform\"; done; else godot --headless --export-release \"$target\"; fi",
      "options": {
        "cwd": "${workspaceFolder}/client/sample-game"
      },
      "problemMatcher": []
    },
    {
      "label": "Godot: Fix game input",
      "group": "godot",
      "type": "shell",
      "command": "set -Eeuo pipefail; settings=\"$HOME/.config/godot/editor_settings-4.7.tres\"; if [[ ! -f \"$settings\" ]]; then echo \"ERROR: Godot editor settings not found: $settings\" >&2; exit 1; fi; if ! grep -q '^run/window_placement/game_embed_mode = ' \"$settings\"; then echo 'ERROR: game_embed_mode setting not found in Godot editor settings.' >&2; exit 1; fi; sed -i 's|^run/window_placement/game_embed_mode = .*|run/window_placement/game_embed_mode = -1|' \"$settings\"; echo 'Godot game input setting is fixed.'",
      "problemMatcher": []
    },
    {
      "label": "Godot: Install Addons",
      "group": "godot",
      "type": "shell",
      "command": "set -Eeuo pipefail; godot --headless -s plug.gd install debug",
      "options": {
        "cwd": "${workspaceFolder}/client/sample-game"
      },
      "problemMatcher": []
    },
    {
      "label": "Godot: Install Export Templates",
      "group": "godot",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/.vscode/scripts/install-godot-export-templates.sh\" \"${workspaceFolder}\"",
      "problemMatcher": []
    },
    {
      "label": "Godot: Start",
      "group": "apps",
      "type": "shell",
      "command": "P=\"${input:godotProjectSelect}\"; godot -e ${P:+\"--path\" \"$P\"}",
      "problemMatcher": []
    },
    {
      "label": "Godot: Start Profiler Server",
      "group": "godot",
      "dependsOn": "Godot: Build",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/scripts/start-godot-profiler.sh",
        "${workspaceFolder}/client/sample-game"
      ],
      "options": {
        "cwd": "${workspaceFolder}/client/sample-game"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Waiting for connection",
          "endsPattern": "DOTNET_DiagnosticPorts="
        }
      }
    },
    {
      "label": "Godot: Stop all processes",
      "group": "godot",
      "type": "shell",
      "command": "ps -eo pid=,comm= | awk 'tolower($2) ~ /^godot/ {print $1}' | xargs -r kill -TERM",
      "problemMatcher": []
    },
    {
      "label": "Godot: Stop Profiler & Convert Trace",
      "group": "godot",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/scripts/stop-godot-profiler.sh",
        "${workspaceFolder}/client/sample-game",
        "${input:traceFormatSelect}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/client/sample-game"
      },
      "problemMatcher": []
    },
    {
      "label": "Nakama: Go Vendor",
      "group": "nakama",
      "type": "shell",
      "command": "go mod vendor",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Nakama: Test",
      "group": "testing",
      "type": "process",
      "command": "go",
      "args": [
        "test",
        "-v",
        "-count=1",
        "--mod=vendor",
        "./..."
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": "$go"
    },
    {
      "label": "Nakama: Build Plugin",
      "group": "build",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/scripts/build-nakama-plugin.sh",
        "${input:pluginNameInput}",
        "${workspaceFolder}"
      ],
      "problemMatcher": "$go",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Nakama: Build & Restart",
      "group": "build",
      "type": "shell",
      "command": "echo 'Nakama plugin built and server restart completed. Use Docker: View Logs to follow server output.'",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Nakama: Go Vendor",
        "Nakama: Build Plugin",
        "Nakama: Restart Server"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Nakama: Restart Server",
      "group": "nakama",
      "type": "shell",
      "command": "docker compose $COMPOSE_ARGS restart nakama",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Nakama: Open Panel",
      "group": "nakama",
      "type": "shell",
      "command": "echo",
      "args": [
        "Done. ${input:openNakamaPanel}"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "never",
        "focus": false,
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "Starship: Install in all terminals",
      "group": "starship",
      "type": "shell",
      "command": "set -Eeuo pipefail; if ! command -v starship >/dev/null 2>&1; then echo 'ERROR: Starship is not installed or not on PATH.' >&2; exit 1; fi; append_once() { local file=\"$1\" line=\"$2\"; mkdir -p \"$(dirname \"$file\")\"; touch \"$file\"; if ! grep -qxF \"$line\" \"$file\"; then printf '%s\\n' \"$line\" >> \"$file\"; fi; }; append_once \"$HOME/.bashrc\" 'eval \"$(starship init bash)\"'; append_once \"$HOME/.zshrc\" 'eval \"$(starship init zsh)\"'; append_once \"$HOME/.config/powershell/Microsoft.PowerShell_profile.ps1\" 'Invoke-Expression (&starship init powershell)'; echo 'Starship startup configuration is present in Bash, Zsh, and PowerShell.'",
      "problemMatcher": []
    },
    {
      "label": "Templates: Instantiate",
      "group": "git",
      "type": "shell",
      "command": "set -Eeuo pipefail; created=0; while IFS= read -r -d '' template; do destination=\"${template%.template}\"; if [[ ! -e \"$destination\" ]]; then cp -- \"$template\" \"$destination\"; printf 'Created: %s\\n' \"$destination\"; ((created += 1)); fi; done < <(find . -type f -name '*.template' -print0); if (( created == 0 )); then echo 'All template files are already instantiated.'; else printf 'Instantiated %s template file(s).\\n' \"$created\"; fi",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "asepriteProjectSelect",
      "type": "pickString",
      "description": "Select the working directory for Aseprite:",
      "default": "client/sample-game/assets",
      "options": [
        {
          "label": "client/sample-game/assets",
          "value": "client/sample-game/assets"
        },
        {
          "label": "Workspace root",
          "value": "."
        }
      ]
    },
    {
      "id": "psdFilePath",
      "type": "promptString",
      "description": "Path of PSD file to repair (eg: assets/personaje.psd)",
      "default": "assets/"
    },
    {
      "id": "godotExportPlatform",
      "type": "pickString",
      "description": "Select export platform:",
      "default": "Windows Desktop",
      "options": [
        {
          "label": "Windows Desktop",
          "value": "Windows Desktop"
        },
        {
          "label": "Linux",
          "value": "Linux"
        },
        {
          "label": "macOS",
          "value": "macOS"
        },
        {
          "label": "All (Build all platforms)",
          "value": "All"
        }
      ]
    },
    {
      "id": "godotProjectSelect",
      "type": "pickString",
      "description": "Select the Godot project to open:",
      "default": "client/sample-game",
      "options": [
        {
          "label": "client/sample-game",
          "value": "client/sample-game"
        },
        {
          "label": "Workspace root (No --path)",
          "value": ""
        }
      ]
    },
    {
      "id": "pluginNameInput",
      "type": "promptString",
      "description": "Name of compiled plugin (without .so)",
      "default": "backend"
    },
    {
      "id": "serviceLogSelect",
      "type": "pickString",
      "description": "Select the service to view its real-time logs:",
      "default": "nakama",
      "options": [
        {
          "label": "Nakama Server (Game Backend)",
          "value": "nakama"
        },
        {
          "label": "PostgreSQL (Database)",
          "value": "postgres"
        },
        {
          "label": "All services",
          "value": ""
        }
      ]
    },
    {
      "id": "logHighlight",
      "type": "promptString",
      "description": "Text to highlight in blue color:",
      "default": "go-project/main.go"
    },
    {
      "id": "traceFormatSelect",
      "type": "pickString",
      "description": "Select trace conversion format (Default: Speedscope):",
      "default": "Chromium",
      "options": [
        {
          "label": "Chromium (chrome://tracing / Perfetto UI)",
          "value": "Chromium"
        },
        {
          "label": "Speedscope (JSON - speedscope.app / VS Code)",
          "value": "Speedscope"
        },
        {
          "label": "NetTrace (Re-export / Keep nettrace)",
          "value": "NetTrace"
        },
        {
          "label": "None (Keep raw .nettrace binary only)",
          "value": "none"
        }
      ]
    },
    {
      "id": "openNakamaPanel",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": [
        "http://localhost:7351/#/"
      ]
    }
  ]
}