{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Instalar Starship en Bashrc",
      "type": "shell",
      "command": "echo 'eval \"$(starship init bash)\"' >> ~/.bashrc && echo '¡Listo!'",
      "problemMatcher": []
    },
    {
      "label": "Iniciar Godot",
      "type": "shell",
      "command": "godot -e",
      "problemMatcher": []
    },
    {
      "label": "Iniciar Aseprite",
      "type": "shell",
      "command": "aseprite",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Detener todos los procesos de Godot",
      "type": "shell",
      "command": "ps -eo pid=,comm= | awk 'tolower($2) ~ /^godot/ {print $1}' | xargs -r kill -TERM",
      "problemMatcher": []
    },
    {
      "label": "fix godot game input",
      "type": "shell",
      "command": "sed -i 's|^run/window_placement/game_embed_mode = .*|run/window_placement/game_embed_mode = -1|' ~/.config/godot/editor_settings-4.7.tres && echo 'Godot game input fixed.'",
      "problemMatcher": []
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/client/sample-game"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}