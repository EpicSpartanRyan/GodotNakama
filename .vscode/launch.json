{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Godot (C#)",
            "type": "coreclr",
            "request": "attach",
            "preLaunchTask": "Godot: Run Game (direct)",
            "processId": "${command:pickProcess}",
            "justMyCode": false
        },
        {
            "name": "Play",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Godot: Build",
            "program": "/usr/local/bin/godot",
            "args": [
                "--path",
                "${workspaceFolder}/client/sample-game"
            ],
            "cwd": "${workspaceFolder}/client/sample-game",
            "stopAtEntry": false
        },
        {
            "name": "Attach",
            "type": "godot-mono",
            "request": "attach",
            "address": "localhost",
            "port": 23685
        },
        {
            "name": "Play & Profile",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Godot: Start Profiler Server",
            "program": "/usr/local/bin/godot",
            "args": [
                "--path",
                "${workspaceFolder}/client/sample-game"
            ],
            "cwd": "${workspaceFolder}/client/sample-game",
            "stopAtEntry": false,
            "env": {
                "DOTNET_DiagnosticPorts": "/tmp/godot-diag,nosuspend"
            }
        }
    ]
}